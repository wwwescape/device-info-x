<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.

   Excludes everything console (private-mode) related from both cloud backup and device-to-device
   transfer, on top of backup_rules.xml which covers the same exclusions for API <31. The console
   Room database is SQLCipher-encrypted with a passphrase held in console_db_key.xml, itself
   Keystore-backed EncryptedSharedPreferences — but Auto Backup would still copy the encrypted
   bytes off-device, and Android Keystore keys never leave the device, so a restored copy would
   be permanently undecryptable garbage rather than simply absent. Excluding outright is cleaner.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="console.db" />
        <exclude domain="database" path="console.db-wal" />
        <exclude domain="database" path="console.db-shm" />
        <exclude domain="database" path="console.db-journal" />
        <exclude domain="sharedpref" path="console_auth.xml" />
        <exclude domain="sharedpref" path="console_db_key.xml" />
        <exclude domain="sharedpref" path="console_server_tokens.xml" />
        <exclude domain="sharedpref" path="console_server_config.xml" />
        <exclude domain="sharedpref" path="console_push_token.xml" />
        <exclude domain="file" path="datastore/console_settings.preferences_pb" />
        <exclude domain="file" path="datastore/console_partner_code.preferences_pb" />
        <exclude domain="file" path="console_media/" />
        <exclude domain="file" path="console_downloads/" />
        <exclude domain="file" path="console_vault/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="console.db" />
        <exclude domain="database" path="console.db-wal" />
        <exclude domain="database" path="console.db-shm" />
        <exclude domain="database" path="console.db-journal" />
        <exclude domain="sharedpref" path="console_auth.xml" />
        <exclude domain="sharedpref" path="console_db_key.xml" />
        <exclude domain="sharedpref" path="console_server_tokens.xml" />
        <exclude domain="sharedpref" path="console_server_config.xml" />
        <exclude domain="sharedpref" path="console_push_token.xml" />
        <exclude domain="file" path="datastore/console_settings.preferences_pb" />
        <exclude domain="file" path="datastore/console_partner_code.preferences_pb" />
        <exclude domain="file" path="console_media/" />
        <exclude domain="file" path="console_downloads/" />
        <exclude domain="file" path="console_vault/" />
    </device-transfer>
</data-extraction-rules>
